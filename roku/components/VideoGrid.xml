<?xml version="1.0" encoding="utf-8"?>
<!--
  Paged library grid. MainScene feeds pages via appendPage(); the grid raises
  `requestPage` when the user nears the end of loaded content.
-->
<component name="VideoGrid" extends="Group">
  <interface>
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="categoryId" type="string" />
    <field id="selectedVideo" type="node" alwaysNotify="true" />
    <field id="requestPage" type="integer" alwaysNotify="true" />
    <field id="loading" type="boolean" onChange="onLoadingChanged" />
    <field id="statusText" type="string" onChange="onStatusChanged" />
    <field id="itemCount" type="integer" value="0" />
    <function name="appendPage" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/VideoGrid.brs" />
  <children>
    <Label id="header" translation="[96, 64]" color="#FFFFFF" font="font:LargeBoldSystemFont" />
    <Label id="count" translation="[96, 122]" color="#B7C0CC" font="font:SmallSystemFont" />
    <MarkupGrid id="grid"
                translation="[96, 180]"
                itemComponentName="VideoCard"
                numColumns="5"
                numRows="3"
                itemSize="[320, 240]"
                itemSpacing="[32, 40]"
                drawFocusFeedback="false"
                vertFocusAnimationStyle="fixedFocus" />
    <Label id="status" translation="[96, 1000]" width="1728" color="#B7C0CC" font="font:SmallSystemFont" />
  </children>
</component>
