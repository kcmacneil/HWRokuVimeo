# --- Vimeo (required) ---
# Personal access token generated at https://developer.vimeo.com/apps
# Required scopes: public private video_files
VIMEO_ACCESS_TOKEN=

# Optional. Numeric Vimeo user id (e.g. 12345678). If omitted, the account that
# owns VIMEO_ACCESS_TOKEN is used via /me.
VIMEO_USER_ID=

# --- Optional behaviour ---
# Shared secret the Roku app must send as "X-Api-Key". Leave empty to disable.
API_KEY=

# Metadata cache lifetime (seconds). Default 300.
CACHE_TTL_SECONDS=300

# Max videos returned per page to Roku (1-100). Default 50.
PAGE_SIZE=50

# Local dev only. Vercel ignores this.
PORT=3000

# Set to "debug" for verbose Vimeo request logging (token is never logged).
LOG_LEVEL=info
